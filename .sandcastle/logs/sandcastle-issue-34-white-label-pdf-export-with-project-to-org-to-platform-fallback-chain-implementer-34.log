import \"jsr:@supabase/functions-js/edge-runtime.d.ts\";
import { PDFDocument, StandardFonts, rgb, type PDFFont, type PDFPage } from \"npm:pdf-lib@1.17.1\";
import { corsHeaders, jsonResponse } from \"../_shared/http.ts\";
import { createUserClient } from \"../_shared/supabase.ts\";

type WhiteLabelConfig = {
  source: \"project\" | \"org\" | \"platform\";
  platform_name: string;
  logo_url: string | null;
  disclaimer: string;
  show_platform_branding: boolean;
};

type Citation = {
  source_document_id: string;
  quote: string;
  locator?: Record<string, unknown>;
};

type Claim = {
  text: string;
  citations: Citation[];
};

type Section = {
  heading: string;
  claims: Claim[];
};

type Footnote = {
  index: number;
  quote: string;
  sourceDocumentId: string;
  sourceUrl: string | null;
  locatorLabel: string;
};

type SourceDocument = {
  id: string;
  source_url: string;
  fetched_at: string;
  kind: string;
};

type ReportRow = {
  id: string;
  project_id: string | null;
  report_type: string;
  created_at: string;
  payload: Record<string, unknown> | null;
  organizations: {
    id: string;
    name: string;
    white_label_config: Record<string, unknown> | null;
  } | null;
  projects: {
    id: string;
    client_name: string;
    white_label_config: Record<string, unknown> | null;
  } | null;
};

type DrawContext = {
  doc: PDFDocument;
  page: PDFPage;
  font: PDFFont;
  boldFont: PDFFont;
  width: number;
  height: number;
  margin: number;
  y: number;
};

const FONT_SIZE_BODY = 10;
const FONT_SIZE_TITLE = 18;
const FONT_SIZE_H2 = 13;
const LINE_HEIGHT = 14;

function readString(value: unknown): string | null {
  if (typeof value "'!== "string") return null;
  const trimmed = value.trim();
  return trimmed.length > 0 ? trimmed : null;
}

function readBoolean(value: unknown): boolean | null {
  return typeof value === "boolean" ? value : null;
}

function parseReportId(url: string): string | null {
  const pathname = new URL(url).pathname;
  const match = pathname.match(/'"\\/(["'^/]+)'"\\.pdf"'$/);
  return match?.[1] ?? null;
}

function resolveWhiteLabel(report: ReportRow): WhiteLabelConfig {
  const platformName = Deno.env.get("PLATFORM_NAME")?.trim() || "Diligence OS";
  const platformDisclaimer =
    Deno.env.get("PLATFORM_DISCLAIMER")?.trim() ||
    "Generated by Diligence OS for informational purposes only.";
  const platformLogo = readString(Deno.env.get("PLATFORM_LOGO_URL"));

  const orgCfg = report.organizations?.white_label_config ?? {};
  const projectCfg = report.projects?.white_label_config ?? {};

  const logoUrl =
    readString(projectCfg.logo_url) ??
    readString(orgCfg.logo_url) ??
    platformLogo;

  const disclaimer =
    readString(projectCfg.disclaimer) ??
    readString(orgCfg.disclaimer) ??
    platformDisclaimer;

  if (report.project_id) {
    return {
      source: "project",
      platform_name: platformName,
      logo_url: logoUrl,
      disclaimer,
      show_platform_branding: false
    };
  }

  const orgShowPlatform = readBoolean(orgCfg.show_platform_branding);
  if (report.organizations?.white_label_config && Object.keys(report.organizations.white_label_config).length > 0) {
    return {
      source: "org",
      platform_name: platformName,
      logo_url: logoUrl,
      disclaimer,
      show_platform_branding: orgShowPlatform ?? true
    };
  }

  return {
    source: "platform",
    platform_name: platformName,
    logo_url: logoUrl,
    disclaimer,
    show_platform_branding: true
  };
}

function wrapText(text: string, font: PDFFont, fontSize: number, maxWidth: number): string[] {
  const words = text.trim().split(/'"\\s+/).filter(Boolean);
  if (words.length === 0) return [];

  const lines: string[] = [];
  let current = \"\";

  for (const word of words) {
    const candidate = current.length > 0 ? "'`${current} ${word}` : word;
    if (font.widthOfTextAtSize(candidate, fontSize) <= maxWidth) {
      current = candidate;
      continue;
    }

    if (current.length > 0) {
      lines.push(current);
      current = word;
      continue;
    }

    lines.push(word);
  }

  if (current.length > 0) {
    lines.push(current);
  }

  return lines;
}

function addPage(ctx: DrawContext): DrawContext {
  const page = ctx.doc.addPage([ctx.width, ctx.height]);
  return { ...ctx, page, y: ctx.height - ctx.margin };
}

function ensureSpace(ctx: DrawContext, lines: number): DrawContext {
  const needed = lines * LINE_HEIGHT;
  if (ctx.y - needed > ctx.margin) return ctx;
  return addPage(ctx);
}

function drawLines(
  ctx: DrawContext,
  lines: string[],
  font: PDFFont,
  fontSize = FONT_SIZE_BODY,
  color = rgb(0.1, 0.1, 0.1)
): DrawContext {
  let next = ensureSpace(ctx, lines.length + 1);
  for (const line of lines) {
    next.page.drawText(line, {
      x: next.margin,
      y: next.y,
      size: fontSize,
      font,
      color
    });
    next.y -= LINE_HEIGHT;
    next = ensureSpace(next, 1);
  }
  return next;
}

function drawParagraph(
  ctx: DrawContext,
  text: string,
  font: PDFFont,
  fontSize = FONT_SIZE_BODY,
  color = rgb(0.1, 0.1, 0.1)
): DrawContext {
  const maxWidth = ctx.width - ctx.margin * 2;
  const lines = wrapText(text, font, fontSize, maxWidth);
  return drawLines(ctx, lines, font, fontSize, color);
}

function drawHeading(ctx: DrawContext, text: string, size: number): DrawContext {
  let next = ensureSpace(ctx, 3);
  next = drawParagraph(next, text, next.boldFont, size, rgb(0, 0, 0));
  next.y -= 4;
  return next;
}

function locatorToLabel(locator: unknown): string {
  if (!locator || typeof locator !== "object") return "locator unavailable";
  const value = locator as Record<string, unknown>;

  if (value.type === "pdf_page" && typeof value.page === "number") {
    return `page ${value.page}`;
  }

  if (
    value.type === "audio_timestamp" &&
    typeof value.start_sec === "number" &&
    typeof value.end_sec === "number"
  ) {
    return `timestamp ${value.start_sec}s-${value.end_sec}s`;
  }

  if (
    value.type === "text_span" &&
    typeof value.start_char === "number" &&
    typeof value.end_char === "number"
  ) {
    return `chars ${value.start_char}-${value.end_char}`;
  }

  if (value.type === "html_anchor" && typeof value.selector === "string") {
    return `anchor ${value.selector}`;
  }

  return "locator unavailable";
}

function asStringArray(value: unknown): string[] {
  if (!Array.isArray(value)) return [];
  return value.filter((entry): entry is string => typeof entry === "string" && entry.trim().length > 0);
}

function extractSections(payload: Record<string, unknown> | null): Section[] {
  if (!payload || !Array.isArray(payload.sections)) return [];

  const sections: Section[] = [];
  for (const rawSection of payload.sections) {
    if (!rawSection || typeof rawSection !== "object") continue;
    const sectionObj = rawSection as Record<string, unknown>;
    const heading = readString(sectionObj.heading) ?? "Section";

    const claims: Claim[] = [];
    const rawClaims = Array.isArray(sectionObj.claims) ? sectionObj.claims : [];
    for (const rawClaim of rawClaims) {
      if (!rawClaim || typeof rawClaim !== "object") continue;
      const claimObj = rawClaim as Record<string, unknown>;
      const text = readString(claimObj.text);
      if (!text) continue;

      const citations: Citation[] = [];
      const rawCitations = Array.isArray(claimObj.citations) ? claimObj.citations : [];
      for (const rawCitation of rawCitations) {
        if (!rawCitation || typeof rawCitation !== "object") continue;
        const citationObj = rawCitation as Record<string, unknown>;
        const sourceDocumentId = readString(citationObj.source_document_id);
        const quote = readString(citationObj.quote);
        if (!sourceDocumentId || !quote) continue;
        citations.push({
          source_document_id: sourceDocumentId,
          quote,
          locator: typeof citationObj.locator === "object" ? (citationObj.locator as Record<string, unknown>) : undefined
        });
      }

      claims.push({ text, citations });
    }

    sections.push({ heading, claims });
  }

  return sections;
}

function extractRedFlags(payload: Record<string, unknown> | null): Claim[] {
  if (!payload || !Array.isArray(payload.red_flags)) return [];

  const claims: Claim[] = [];
  for (const rawFlag of payload.red_flags) {
    if (!rawFlag || typeof rawFlag !== "object") continue;
    const flagObj = rawFlag as Record<string, unknown>;
    const text = readString(flagObj.text);
    if (!text) continue;

    const citations: Citation[] = [];
    const rawCitations = Array.isArray(flagObj.citations) ? flagObj.citations : [];
    for (const rawCitation of rawCitations) {
      if (!rawCitation || typeof rawCitation !== "object") continue;
      const citationObj = rawCitation as Record<string, unknown>;
      const sourceDocumentId = readString(citationObj.source_document_id);
      const quote = readString(citationObj.quote);
      if (!sourceDocumentId || !quote) continue;
      citations.push({
        source_document_id: sourceDocumentId,
        quote,
        locator: typeof citationObj.locator === "object" ? (citationObj.locator as Record<string, unknown>) : undefined
      });
    }

    claims.push({ text, citations });
  }

  return claims;
}

async function tryDrawLogo(ctx: DrawContext, logoUrl: string): Promise<DrawContext> {
  try {
    const response = await fetch(logoUrl);
    if (!response.ok) throw new Error(`logo fetch failed: ${response.status}`);

    const contentType = response.headers.get("content-type") ?? "";
    const bytes = await response.arrayBuffer();

    const image = contentType.includes("png")
      ? await ctx.doc.embedPng(bytes)
      : contentType.includes("jpeg") || contentType.includes("jpg")
        ? await ctx.doc.embedJpg(bytes)
        : null;

    if (!image) throw new Error("unsupported logo image type");

    const maxWidth = 140;
    const maxHeight = 56;
    const scaled = image.scale(Math.min(maxWidth / image.width, maxHeight / image.height, 1));

    let next = ensureSpace(ctx, 6);
    next.page.drawImage(image, {
      x: next.margin,
      y: next.y - scaled.height,
      width: scaled.width,
      height: scaled.height
    });
    next.y -= scaled.height + 8;
    return next;
  } catch {
    return drawParagraph(ctx, `Logo: ${logoUrl}`, ctx.font);
  }
}

function formatIsoTimestamp(value: string): string {
  const date = new Date(value);
  if (Number.isNaN(date.getTime())) return value;
  return date.toISOString();
}

function fileSafeSlug(value: string): string {
  return value.toLowerCase().replace(/[''^a-z0-9]+/g, "-").replace(/''^-+|-+$/g, "");
}

async function renderPdf(
  report: ReportRow,
  whiteLabel: WhiteLabelConfig,
  sourceDocuments: SourceDocument[]
): Promise<Uint8Array> {
  const doc = await PDFDocument.create();
  const font = await doc.embedFont(StandardFonts.Helvetica);
  const boldFont = await doc.embedFont(StandardFonts.HelveticaBold);

  let ctx: DrawContext = {
    doc,
    page: doc.addPage([612, 792]),
    font,
    boldFont,
    width: 612,
    height: 792,
    margin: 48,
    y: 792 - 48
  };

  if (whiteLabel.logo_url) {
    ctx = await tryDrawLogo(ctx, whiteLabel.logo_url);
  }

  ctx = drawHeading(ctx, `${report.report_type.replaceAll("_", " ")} report`, FONT_SIZE_TITLE);

  if (report.projects?.client_name) {
    ctx = drawParagraph(ctx, `Client: ${report.projects.client_name}`, boldFont);
  }

  if (report.organizations?.name) {
    ctx = drawParagraph(ctx, `Organization: ${report.organizations.name}`, font);
  }

  ctx = drawParagraph(ctx, `Generated at: ${formatIsoTimestamp(report.created_at)}`, font);
  ctx.y -= 8;

  const payload = report.payload;
  const executiveSummary = readString(payload?.executive_summary) ?? "No executive summary available.";
  ctx = drawHeading(ctx, "Executive Summary", FONT_SIZE_H2);
  ctx = drawParagraph(ctx, executiveSummary, font);

  const keyTakeaways = asStringArray(payload?.key_takeaways);
  if (keyTakeaways.length > 0) {
    ctx = drawHeading(ctx, "Key Takeaways", FONT_SIZE_H2);
    for (const takeaway of keyTakeaways) {
      ctx = drawParagraph(ctx, `- ${takeaway}`, font);
    }
  }

  const sourceDocumentById = new Map(sourceDocuments.map((sourceDocument) => [sourceDocument.id, sourceDocument]));
  const footnotes: Footnote[] = [];

  const appendClaim = (claim: Claim): string => {
    const markers: string[] = [];
    for (const citation of claim.citations) {
      const nextIndex = footnotes.length + 1;
      const source = sourceDocumentById.get(citation.source_document_id);
      footnotes.push({
        index: nextIndex,
        quote: citation.quote,
        sourceDocumentId: citation.source_document_id,
        sourceUrl: source?.source_url ?? null,
        locatorLabel: locatorToLabel(citation.locator)
      });
      markers.push(`[${nextIndex}]`);
    }

    return markers.length > 0 ? `${claim.text} ${markers.join("")}` : claim.text;
  };

  const sections = extractSections(payload);
  if (sections.length > 0) {
    for (const section of sections) {
      ctx = drawHeading(ctx, section.heading, FONT_SIZE_H2);
      for (const claim of section.claims) {
        ctx = drawParagraph(ctx, `- ${appendClaim(claim)}`, font);
      }
    }
  }

  const redFlags = extractRedFlags(payload);
  if (redFlags.length > 0) {
    ctx = drawHeading(ctx, "Red Flags", FONT_SIZE_H2);
    for (const redFlag of redFlags) {
      ctx = drawParagraph(ctx, `- ${appendClaim(redFlag)}`, font);
    }
  }

  if (footnotes.length > 0) {
    ctx = drawHeading(ctx, "Footnotes", FONT_SIZE_H2);
    for (const footnote of footnotes) {
      const sourceRef = footnote.sourceUrl ?? `source_document_id=${footnote.sourceDocumentId}`;
      const footnoteLine = `[${footnote.index}] "${footnote.quote}" (${footnote.locatorLabel}; ${sourceRef})`;
      ctx = drawParagraph(ctx, footnoteLine, font);
    }
  }

  ctx = addPage(ctx);
  ctx = drawHeading(ctx, "Sources", FONT_SIZE_H2);
  if (sourceDocuments.length === 0) {
    ctx = drawParagraph(ctx, "No source documents recorded for this report.", font);
  } else {
    for (const sourceDocument of sourceDocuments) {
      ctx = drawParagraph(
        ctx,
        `- [${sourceDocument.kind}] ${sourceDocument.source_url} | fetched_at=${formatIsoTimestamp(sourceDocument.fetched_at)}`,
        font
      );
    }
  }

  ctx.y -= 10;
  ctx = drawHeading(ctx, "Disclaimer", FONT_SIZE_H2);
  ctx = drawParagraph(ctx, whiteLabel.disclaimer, font);

  if (whiteLabel.show_platform_branding) {
    ctx = drawParagraph(ctx, `Powered by ${whiteLabel.platform_name}`, boldFont);
  }

  return await doc.save();
}

Deno.serve(async (request) => {
  if (request.method === "OPTIONS") {
    return new Response("ok", { headers: corsHeaders });
  }

  if (request.method !== "GET") {
    return jsonResponse(405, { error: "Method not allowed" });
  }

  const authorization = request.headers.get("Authorization");
  if (!authorization) {
    return jsonResponse(401, { error: "Missing Authorization header" });
  }

  const reportId = parseReportId(request.url);
  if (!reportId) {
    return jsonResponse(400, { error: "Invalid report id in path. Expected /exports/:report_id.pdf" });
  }

  const supabase = createUserClient(authorization);

  const { data: activeOrgId, error: activeOrgError } = await supabase.rpc("current_active_org");
  if (activeOrgError || !activeOrgId) {
    return jsonResponse(403, { error: "No active organization context" });
  }

  const { data: report, error: reportError } = await supabase
    .from("reports")
    .select(
      `
      id,
      project_id,
      report_type,
      created_at,
      payload,
      organizations:org_id (id, name, white_label_config),
      projects:project_id (id, client_name, white_label_config)
      `
    )
    .eq("id", reportId)
    .eq("status", "succeeded")
    .single();

  if (reportError || !report) {
    return jsonResponse(404, { error: "Report not found" });
  }

  const whiteLabel = resolveWhiteLabel(report as ReportRow);

  const payload = (report.payload ?? {}) as Record<string, unknown>;
  const sourceDocumentIds = asStringArray(payload.source_documents_used);

  let sourceDocuments: SourceDocument[] = [];
  if (sourceDocumentIds.length > 0) {
    const { data, error } = await supabase
      .from("source_documents")
      .select("id, source_url, fetched_at, kind")
      .in("id", sourceDocumentIds);

    if (!error && data) {
      sourceDocuments = data as SourceDocument[];
      sourceDocuments.sort((left, right) => left.fetched_at.localeCompare(right.fetched_at));
    }
  }

  const bytes = await renderPdf(report as ReportRow, whiteLabel, sourceDocuments);
  const fileName = `report-${fileSafeSlug(reportId)}.pdf`;

  return new Response(bytes, {
    status: 200,
    headers: {
      ...corsHeaders,
      "Content-Type": "application/pdf",
      "Content-Disposition": `inline; filename="${fileName}"`,
      "Cache-Control": "no-store"
    }
  });
});
