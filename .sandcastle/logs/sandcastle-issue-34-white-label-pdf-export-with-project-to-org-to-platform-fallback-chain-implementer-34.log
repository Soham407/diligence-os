create or replace function public.resolve_white_label_config(p_report_id uuid)
returns jsonb
language plpgsql
security invoker
set search_path = public
as "'$$
declare
  report_row record;
  project_cfg jsonb := '"'{}'::jsonb;
  org_cfg jsonb := '{}'::jsonb;
  platform_cfg jsonb := jsonb_build_object(
    'platform_name', 'Diligence OS',
    'logo_url', null,
    'disclaimer', 'Generated by Diligence OS for informational purposes only.',
    'show_platform_branding', true
  );
  resolved_logo_url text;
  resolved_disclaimer text;
  resolved_source text;
  show_platform_branding boolean;
begin
  select
    r.id,
    r.project_id,
    o.white_label_config as org_white_label_config,
    p.white_label_config as project_white_label_config
  into report_row
  from public.reports r
  join public.organizations o on o.id = r.org_id
  left join public.projects p on p.id = r.project_id
  where r.id = p_report_id;

  if not found then
    raise exception 'report not found or inaccessible';
  end if;

  if report_row.project_white_label_config is not null then
    project_cfg := report_row.project_white_label_config;
  end if;

  if report_row.org_white_label_config is not null then
    org_cfg := report_row.org_white_label_config;
  end if;

  resolved_logo_url := coalesce(
    nullif(trim(project_cfg->>'logo_url'), ''),
    nullif(trim(org_cfg->>'logo_url'), ''),
    nullif(trim(platform_cfg->>'logo_url'), '')
  );

  resolved_disclaimer := coalesce(
    nullif(trim(project_cfg->>'disclaimer'), ''),
    nullif(trim(org_cfg->>'disclaimer'), ''),
    platform_cfg->>'disclaimer'
  );

  if report_row.project_id is not null then
    resolved_source := 'project';
    show_platform_branding := false;
  elsif org_cfg <> '{}'::jsonb then
    resolved_source := 'org';
    show_platform_branding := coalesce((org_cfg->>'show_platform_branding')::boolean, true);
  else
    resolved_source := 'platform';
    show_platform_branding := coalesce((platform_cfg->>'show_platform_branding')::boolean, true);
  end if;

  return jsonb_build_object(
    'source', resolved_source,
    'platform_name', platform_cfg->>'platform_name',
    'logo_url', to_jsonb(resolved_logo_url),
    'disclaimer', resolved_disclaimer,
    'show_platform_branding', show_platform_branding
  );
end;
"'$$;

grant execute on function public.resolve_white_label_config(uuid) to authenticated;
SQL')
