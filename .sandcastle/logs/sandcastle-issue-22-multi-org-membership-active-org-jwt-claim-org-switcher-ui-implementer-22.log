  \"Access-Control-Allow-Headers\": \"authorization, x-client-info, apikey, content-type\",
  \"Access-Control-Allow-Methods\": \"POST, OPTIONS\"
};

function jsonResponse(body: Record<string, unknown>, status = 200) {
  return new Response(JSON.stringify(body), {
    status,
    headers: {
      ...corsHeaders,
      \"Content-Type\": \"application/json\"
    }
  });
}

Deno.serve(async (req) => {
  if (req.method === \"OPTIONS\") {
    return new Response(\"ok\", { headers: corsHeaders });
  }

  if (req.method "'!== "POST") {
    return jsonResponse({ error: "Method not allowed" }, 405);
  }

  const supabaseUrl = Deno.env.get("SUPABASE_URL");
  const supabaseAnonKey = Deno.env.get("SUPABASE_ANON_KEY");
  const supabaseServiceRoleKey = Deno.env.get("SUPABASE_SERVICE_ROLE_KEY");

  if (!supabaseUrl || !supabaseAnonKey || !supabaseServiceRoleKey) {
    return jsonResponse({ error: "Missing Supabase environment variables." }, 500);
  }

  const authorization = req.headers.get("Authorization");
  if (!authorization) {
    return jsonResponse({ error: "Missing Authorization header." }, 401);
  }

  const userClient = createClient(supabaseUrl, supabaseAnonKey, {
    global: {
      headers: { Authorization: authorization }
    },
    auth: {
      autoRefreshToken: false,
      persistSession: false
    }
  });

  const {
    data: { user },
    error: userError
  } = await userClient.auth.getUser();

  if (userError || !user) {
    return jsonResponse({ error: "Unauthorized." }, 401);
  }

  let parsedBody: SwitchOrgRequest;
  try {
    parsedBody = (await req.json()) as SwitchOrgRequest;
  } catch {
    return jsonResponse({ error: "Invalid JSON body." }, 400);
  }

  const orgId = parsedBody.org_id;
  if (!orgId || typeof orgId !== "string") {
    return jsonResponse({ error: "org_id is required." }, 400);
  }

  const serviceClient = createClient(supabaseUrl, supabaseServiceRoleKey, {
    auth: {
      autoRefreshToken: false,
      persistSession: false
    }
  });

  const { data: membership, error: membershipError } = await serviceClient
    .from("org_members")
    .select("org_id")
    .eq("org_id", orgId)
    .eq("user_id", user.id)
    .maybeSingle();

  if (membershipError) {
    return jsonResponse({ error: "Failed membership lookup." }, 500);
  }

  if (!membership) {
    return jsonResponse({ error: "Forbidden: user is not a member of this org." }, 403);
  }

  const { error: profileError } = await serviceClient
    .from("user_profiles")
    .update({ last_active_org_id: orgId })
    .eq("user_id", user.id);

  if (profileError) {
    return jsonResponse({ error: "Failed to update profile active org." }, 500);
  }

  const nextAppMetadata = {
    ...(user.app_metadata ?? {}),
    active_org_id: orgId
  };

  const { error: updateUserError } = await serviceClient.auth.admin.updateUserById(user.id, {
    app_metadata: nextAppMetadata
  });

  if (updateUserError) {
    return jsonResponse({ error: "Failed to update auth app metadata." }, 500);
  }

  // Client should refresh the session immediately; the custom access token hook will issue a JWT
  // that carries the updated app_metadata.active_org_id claim.
  return jsonResponse({ active_org_id: orgId, switched: true }, 200);
});
TS')
