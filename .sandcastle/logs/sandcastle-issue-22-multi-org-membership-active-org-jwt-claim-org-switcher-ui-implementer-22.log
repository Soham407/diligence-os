Bash(/bin/bash -lc "cat > supabase/migrations/20260510003000_issue_22_multi_org_active_org_hook.sql <<'SQL'
create or replace function public.resolve_active_org_for_user(target_user_id uuid) returns uuid
language plpgsql
stable
security definer
set search_path = public
as "'$$
declare
  preferred_org_id uuid;
  personal_org_id uuid;
  fallback_org_id uuid;
begin
  select up.last_active_org_id, up.personal_org_id
  into preferred_org_id, personal_org_id
  from public.user_profiles up
  where up.user_id = target_user_id;

  if preferred_org_id is not null and exists (
    select 1
    from public.org_members om
    where om.user_id = target_user_id
      and om.org_id = preferred_org_id
  ) then
    return preferred_org_id;
  end if;

  if personal_org_id is not null and exists (
    select 1
    from public.org_members om
    where om.user_id = target_user_id
      and om.org_id = personal_org_id
  ) then
    return personal_org_id;
  end if;

  select om.org_id
  into fallback_org_id
  from public.org_members om
  where om.user_id = target_user_id
  order by om.created_at asc
  limit 1;

  return fallback_org_id;
end;
$$;

create or replace function public.custom_access_token_hook(event jsonb)
returns jsonb
language plpgsql
stable
security definer
set search_path = public
as $$
declare
  updated_claims jsonb := coalesce(event -> '"'claims', '{}'::jsonb);
  updated_app_metadata jsonb := coalesce(updated_claims -> 'app_metadata', '{}'::jsonb);
  target_user_id uuid := (event ->> 'user_id')::uuid;
  selected_org_id uuid;
begin
  selected_org_id := public.resolve_active_org_for_user(target_user_id);

  if selected_org_id is not null then
    updated_app_metadata := updated_app_metadata || jsonb_build_object('active_org_id', selected_org_id::text);
  else
    updated_app_metadata := updated_app_metadata - 'active_org_id';
  end if;

  updated_claims := jsonb_set(updated_claims, '{app_metadata}', updated_app_metadata, true);

  return jsonb_build_object('claims', updated_claims);
end;
"'$$;

grant usage on schema public to supabase_auth_admin;
grant execute on function public.custom_access_token_hook(jsonb) to supabase_auth_admin;
SQL')
